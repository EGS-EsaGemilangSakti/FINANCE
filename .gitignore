# Local scratch and generated review artifacts
/tmp/

# Client source documents and generated requirements remain local
/doc/
/output/

# Dependency and build directories (defense in depth; app-level ignores also apply)
**/node_modules/
**/vendor/
**/.next/
**/public/build/

# Environment files and credentials
**/.env
**/.env.*
!**/.env.example
*.pem

# Logs, caches, and editor metadata
*.log
**/.phpunit.cache/
**/.phpunit.result.cache
**/*.tsbuildinfo
.DS_Store
Thumbs.db
.idea/
.vscode/
